{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "syifa-my/platform",
    "type": "project",
    "description": "Engineering foundation for the Syifa.my platform.",
    "keywords": [
        "laravel",
        "syifa"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.0",
        "predis/predis": "^2.3",
        "spomky-labs/otphp": "^11.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "dev:install": "launchctl bootstrap gui/$(id -u) scripts/com.syifa.devserver.plist || launchctl kickstart -k gui/$(id -u)/com.syifa.devserver",
        "dev:server": "bash scripts/dev-server.sh",
        "format": "pint",
        "format:check": "pint --test",
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
        "pre-package-uninstall": "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
