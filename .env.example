APP_NAME=Syifa.my
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PUBLIC_WEBSITE_BASE_DOMAIN=syifa.my

RELEASE_VERSION=unknown
RELEASE_BUILD_ID=unknown
RELEASE_COMMIT=unknown
RELEASE_BUILT_AT=unknown
OPERATIONS_RUNTIME_CHECKS_ENABLED=true
OPERATIONS_REDIS_CONNECTION=default

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=syifa
DB_USERNAME=syifa
DB_PASSWORD=syifa_local_password

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SESSION_DB=2

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@syifa.my"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta WhatsApp Cloud API. The booking template body must have six variables:
# patient name, booking reference, appointment date, appointment time, service, patient phone.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BOOKING_TEMPLATE=booking_received_clinic
WHATSAPP_TEMPLATE_LANGUAGE=ms

# Governed Website content assistance. Keep disabled until an API key,
# tenant allowance and operating budget have been approved.
SYIFA_AI_ENABLED=false
SYIFA_AI_PROVIDER=openai
SYIFA_AI_MODEL=gpt-5.6-luna
SYIFA_AI_TIMEOUT_SECONDS=30
SYIFA_AI_MAX_OUTPUT_TOKENS=1400
SYIFA_AI_MONTHLY_TENANT_TOKEN_LIMIT=250000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
REQUEST_PROTECTION_SYIFA_AI_MAX_ATTEMPTS=12
REQUEST_PROTECTION_SYIFA_AI_DECAY_SECONDS=60

TENANT_ADMIN_BASE_DOMAINS=app.syifa.my
LOCAL_DEMO_TENANT_ENABLED=true
LOCAL_DEMO_TENANT_HOST=localhost
LOCAL_DEMO_TENANT_ROUTING_LABEL=demo-clinic

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_SESSION_ABSOLUTE_LIFETIME=720
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10
AUTH_REMEMBER_MINUTES=43200
AUTH_RESET_TOKEN_MINUTES=60
AUTH_VERIFICATION_TOKEN_MINUTES=60

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL="${APP_URL}/payments/return"
STRIPE_CANCEL_URL="${APP_URL}/payments/cancel"

TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_RETURN_URL="${APP_URL}/payments/return"
TOYYIBPAY_CALLBACK_URL="${APP_URL}/api/v1/payment-provider-webhooks/toyyibpay"

REQUEST_PROTECTION_PAYMENT_WEBHOOK_MAX_ATTEMPTS=300
REQUEST_PROTECTION_PAYMENT_WEBHOOK_DECAY_SECONDS=60

# Local Syifa Essential website preview only. This mapping is ignored unless
# APP_ENV=local (see config/public_website_delivery.php). It has no effect in
# any deployed environment. Run `php artisan syifa:preview:setup` first.
PUBLIC_WEBSITE_ASSET_ORIGIN=http://localhost:8000
PUBLIC_WEBSITE_RUNTIME_ADDRESSING=true
PUBLIC_LEGAL_PRIVACY_PATH=
PUBLIC_LEGAL_TERMS_PATH=
PUBLIC_WEBSITE_CUSTOM_DOMAIN_TARGETS=
ACQUISITION_OFFER_SERVICE_SETUP_CAPABILITY_KEY=booking.manage
PUBLIC_WEBSITE_PREVIEW_HOST=localhost
PUBLIC_WEBSITE_PREVIEW_WEBSITE_ID=00000000-0000-4000-8000-100000000030
PUBLIC_WEBSITE_PREVIEW_SCHEME=http
PLATFORM_MFA_ENABLED=false
